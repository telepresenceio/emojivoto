services:
  web:
    image: ${IMAGE_REGISTRY}/emojivoto-web:${IMAGE_TAG}
    environment:
      - WEB_PORT=8080
      - EMOJISVC_HOST=emoji:8080
      - VOTINGSVC_HOST=voting:8080
      - INDEX_BUNDLE=dist/index_bundle.js
    ports:
      - "8080:8080"
    depends_on:
      - voting
      - emoji

  vote-bot:
    image: ${IMAGE_REGISTRY}/emojivoto-web:${IMAGE_TAG}
    entrypoint: emojivoto-vote-bot
    environment:
      - WEB_HOST=web:8080
    depends_on:
      - web

  emoji:
    image: ${IMAGE_REGISTRY}/emojivoto-emoji:${IMAGE_TAG}
    environment:
      - GRPC_PORT=8080
    ports:
      - "8081:8080"

  voting:
    image: ${IMAGE_REGISTRY}/emojivoto-voting:${IMAGE_TAG}
    environment:
      - GRPC_PORT=8080
    ports:
      - "8082:8080"
