resources:
- ns.yaml
- web.yaml
- emoji.yaml
- voting.yaml
- vote-bot.yaml

images:
  - name: emojivoto-web
    newName: ${IMAGE_REGISTRY}/emojivoto-web
    newTag: ${IMAGE_TAG}
  - name: emojivoto-emoji
    newName: ${IMAGE_REGISTRY}/emojivoto-emoji
    newTag: ${IMAGE_TAG}
  - name: emojivoto-voting
    newName: ${IMAGE_REGISTRY}/emojivoto-voting
    newTag: ${IMAGE_TAG}

labels:
  - includeSelectors: true
    pairs:
      version: ${IMAGE_TAG}
  - includeTemplates: false
    pairs:
      app.kubernetes.io/version: ${IMAGE_TAG}